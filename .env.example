# Server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Visual Crossing Weather API
# Get a key at https://www.visualcrossing.com/weather-api
VISUAL_CROSSING_API_KEY=replace-with-your-api-key
WEATHER_UNIT_SYSTEM=metric

# Caching
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=43200

# Rate limit per client IP
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
